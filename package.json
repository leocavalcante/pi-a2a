{
  "name": "@leocavalcante/pi-a2a",
  "version": "0.4.0",
  "description": "Talk to A2A agents from Pi, and serve Pi Durable agents over the A2A protocol.",
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi-coding-agent",
    "pi-durable",
    "a2a",
    "a2a-protocol",
    "agent-to-agent",
    "agent-communication",
    "multi-agent",
    "ai-agents"
  ],
  "homepage": "https://github.com/leocavalcante/pi-a2a#readme",
  "bugs": {
    "url": "https://github.com/leocavalcante/pi-a2a/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leocavalcante/pi-a2a.git"
  },
  "license": "MIT",
  "author": "Leo Cavalcante (https://github.com/leocavalcante)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./extension": "./src/extension.ts"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json && tsc -p tests && tsc -p examples",
    "test": "bun run test:bun && bun run test:node",
    "test:bun": "bun run build && bun test --timeout 30000",
    "test:node": "node --import jiti/register --test --test-timeout=30000 --test-concurrency=1 tests/*.node-test.ts",
    "check:package": "bun run build && publint && node .github/scripts/check-package.mjs",
    "verify": "bun run check && bun run test && bun run check:package && bun audit --audit-level=high",
    "example": "node --import jiti/register examples/echo.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "unpdf": "1.9.1"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-durable": "1.5.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/chord": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@types/bun": "1.4.4",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "express": "5.1.0",
    "jiti": "2.7.0",
    "publint": "0.3.25",
    "typebox": "1.4.4",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
